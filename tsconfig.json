{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "docs/.vitepress/config.mts",
    "docs/.vitepress/theme/**/*",
    "wrangler.config.ts",
    "cloudflare.config.ts",
    "scripts/**/*.mjs",
    "env.d.ts"
  ]
}
